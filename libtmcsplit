const
  _libcrash =
    await import(
      "libcrash-js");
/* global
     _basename */
const
  _basename =
    _libcrash._basename;
/* global
     _dirname */
const
  _dirname =
    _libcrash._dirname;
/* global
     _dir_exists */
const
  _dir_exists =
    _libcrash._dir_exists;
/* global
     _file_exists */
const
  _file_exists =
    _libcrash._file_exists;
/* global
     _ls */
const
  _ls =
    _libcrash._ls;
/* global
     _msg_error */
const
  _msg_error =
    _libcrash._msg_error;
/* global
     _msg_info */
const
  _msg_info =
    _libcrash._msg_info;
/* global
     _msg_warning */
const
  _msg_warning =
    _libcrash._msg_warning;
/* global
     _mv */
const
  _mv =
    _libcrash._mv;
/* global
     _require */
const
  _require =
    _libcrash._require;
const
  _split_file_module =
    await _require(
      "split-file");
/* global
     _split_file */
const
  _split_file =
    _split_file_module._split_file;
/* global
     _split_file_by_size */
const
  _split_file_by_size =
    _split_file_module._split_file_by_size;

async function
  _output_files_get(
    _input_file,
    _output_prefix) {
  let
    _cursor,
    _file,
    _encoded_files,
    _msg,
    _mv_args,
    _output_file,
    _output_files,
    _part_no;
  _output_files =
    [];
  const
    _file_name =
      _basename(
        _input_file);
  const
    _pattern =
      `${_file_name}.sf-part`
  const
    _dir =
      _dirname(
        _input_file);
  const
    _dir_content =
      await _ls(
        _dir);
  for ( _file of _dir_content ) {
    if ( _file.startsWith(
           _pattern)) {
      _part_no =
        _file.replace(
          _pattern,
          "");
      _input_file =
        `${_input_file}.sf-part${_part_no}`,
      _output_file =
        `${_output_prefix}${_part_no}`;
      _encoded_files.push(
        _input_file);
      _output_files.push(
        _output_file);
    }
  }
  _cursor =
    0;
  for ( _file of _encoded_files ) {
    _output_file =
      _output_files[
        _cursor];
    _mv_args = [
      _file,
      _output_file
    ];
    _mv.apply(
      null,
      _mv_args);
    _cursor =
      _cursor + 1;
  }
  return _output_files;
}

function
  _input_file_check(
    _input_file) {
  let
    _msg;
  const
    _input_file_type =
      typeof(
        _input_file);
  if ( _input_file_type === "undefined" ) {
    _msg =
      "Input file is undefined.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  else if ( _input_file_type === "string" ) {
    if ( _input_file.length < 1 ) {
      _msg =
        "Input file is an empty string.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else if ( _input_file_type === "number" ) {
    _input_file =
      String(
        _input_file);
    _msg =
      "Input file path variable was a number, " +
      "not a string.";
    _msg_warning(
      _msg);
  }
  else {
    _msg =
      "Input file variable should be a string.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( ! _file_exists(
           _input_file) ) {
    _msg =
      "Input file " +
      `'${_input_file}' does not exist.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _input_file;
}

function
  _output_prefix_check(
    _output_prefix,
    _input_file) {
  let
    _msg,
    _output_prefix_get;
  _output_prefix_get =
    false;
  const
    _output_prefix_type =
      typeof(
        _output_prefix);
  if ( _output_prefix_type === "undefined" ) {
    _msg =
      "Output prefix variable is undefined, " +
      "setting default (same as input file).";
    _msg_info(
      _msg);
    _output_prefix_get =
      true;
  }
  else if ( _output_prefix_type === "string" ) {
    if ( _output_prefix.length < 1 ) {
      _msg =
        "Output prefix variable is an empty string, " +
        "setting default (same as input file).";
      _msg_info(
        _msg);
    }
  }
  else if ( _output_prefix_type === "number" ) {
    _output_prefix =
      String(
        _output_prefix);
  }
  else if ( _output_prefix_type === "object" ) {
    _output_prefix_keys =
      Object.keys(
        _output_prefix);
    if ( _output_prefix_keys.length < 1 ) {
      _msg =
        "Output prefix variable is an empty object, " +
        "setting default (same as input file).";
      _msg_info(
        _msg);
    }
    else {
      _msg =
        "Output prefix variable has type " +
        `'${_output_prefix_type}', but it should be ` +
        "a file path pattern (a string).";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else {
    _msg =
      "Output prefix variable has type " +
      `'${_output_prefix_type}', but it should be ` +
      "a file path pattern (a string).";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _output_prefix_get ) {
    const
      _input_file_type =
        typeof(
          _input_file);
    if ( _input_file_type === "string" ) {
      if ( 0 < _input_file.length ) {
        _output_prefix =
          _input_file;
      }
    }
  }
  const
    _output_dir =
      _dirname(
        _output_prefix);
  if ( ! _dir_exists(
           _output_dir) ) {
    _msg =
      "Output directory " +
      `'${_output_dir}' does not ` +
      "exist.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _output_prefix;
}

async function
  _split(
    _input_file,
    _output_prefix,
    _chunks_amount,
    _size_max) {
  let
    _msg,
    _output_files;
  try {
    _input_file =
      _input_file_check(
        _input_file);
  }
  catch(
    _error) {
    _msg =
      "Error running '_input_file_check'.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  try {
    _output_prefix =
      _output_prefix_check(
        _output_prefix);
  }
  catch(
    _error) {
    _msg =
      "Error running '_output_prefix_check'.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  const
    _chunks_amount_not_number =
      typeof(
        _chunks_amount) !== "number";
  if ( _chunks_amount_not_number ) {
    _msg =
      "Chunks amount must be a number.";
    _msg_error(
      _msg,
      1);
  }
  _msg =
    `Splitting '${_input_file}' ` +
    `into '${_chunks_amount}' of size '${_size_max}' ` +
    `into files with prefix '${_output_prefix}':`;
  _msg_info(
    _msg);
  _size_max =
    Number(
      _size_max);
  if ( _chunks_amount > 0 ) {
    await _split_file(
      _input_file,
      _chunks_amount);
  }
  else if ( _size_max > 0 ) {
    await _split_file_by_size(
      _input_file,
      _size_max);
  }
  _output_files =
    _output_files_get(
      _input_file,
      _output_prefix);
  return _output_files;
}

// ES exports

export {
  _split
};

